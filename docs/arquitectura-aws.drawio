<mxCell id="ops-note" value="OPERACIÓN. GitHub Actions ejecuta Terraform; el state remoto se almacena en S3. Lambda utiliza LabRole y registra logs en CloudWatch. Sin VPC ni EC2." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;dashed=1;align=left;spacingLeft=12;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="795" y="990" width="745" height="95" as="geometry"/></mxCell>
